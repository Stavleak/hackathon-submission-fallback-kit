{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fallback submission manifest / Манифест резервной сдачи",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "teamReference",
    "receivedAt",
    "deadline",
    "channel",
    "fixedVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "teamReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "enum": [
        "primary",
        "fallback"
      ]
    },
    "incidentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "fixedVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 26214400
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "fallback"
          }
        }
      },
      "then": {
        "required": [
          "incidentReference"
        ]
      }
    }
  ]
}